{
  "name": "krisha-agent",
  "version": "1.0.0",
  "description": "Персональный агент поиска квартир на Krisha.kz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "once": "tsx -e \"import('./src/scheduler.js').then(m => m.runPipeline())\"",
    "build": "tsc"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}