# ─────────── Твой WhatsApp (куда агент шлёт уведомления и черновики) ───────────
# Только цифры с кодом страны, без "+". Пример для Казахстана: 77001234567
MY_WHATSAPP=77001234567

# ─────────── Anthropic API (диалог с хозяином) ───────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────── Green API (WhatsApp) ───────────
# Возьми в личном кабинете green-api.com после создания инстанса
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Необязательно: если в кабинете указан персональный хост инстанса (напр. https://1103.api.green-api.com)
# GREEN_API_URL=https://api.green-api.com
