# ─────────── Твой WhatsApp (куда приходит сводка и алерты по цене) ───────────
# Только цифры с кодом страны, без "+". Пример для Казахстана: 77001234567
MY_WHATSAPP=77001234567

# ─────────── Anthropic API (формирует текст дневной сводки на русском) ───────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────── Green API (отправка в WhatsApp) ───────────
# Возьми в личном кабинете green-api.com после создания инстанса.
# Green API автоматизирует WhatsApp неофициально — привязывай отдельную SIM, а не основной номер.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Необязательно: если в кабинете указан персональный хост инстанса (напр. https://1103.api.green-api.com)
# GREEN_API_URL=https://api.green-api.com

# ─────────── Необязательно: доп. номера только для дневной сводки (через запятую) ───────────
# DIGEST_WHATSAPP=77001234567,77009876543
